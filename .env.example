# ==============================================================================
# StreamForge – Environment Variables Template
# ==============================================================================
# Copy this file to .env or .env.local and update with your real secrets.
# Never commit .env or secrets to version control.

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 16 + Prisma 6)
# ------------------------------------------------------------------------------
# DATABASE_URL: Pooled connection string used by Next.js application & Server Actions
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streamforge?schema=public"

# DATABASE_DIRECT_URL: Non-pooled direct connection string used for migrations & pg-boss worker
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/streamforge?schema=public"

# Shadow database for Prisma migrations in dev/staging
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streamforge_shadow?schema=public"

# ------------------------------------------------------------------------------
# 2. Redis (Rate Limiting & Token Blacklist)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. Authentication & Security Secrets (Argon2id + JWT + HMAC)
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret for HS256 JWT access tokens
JWT_ACCESS_SECRET="streamforge_jwt_access_secret_key_minimum_32_characters_long_local"

# Minimum 32-character secret for HS256 JWT refresh token family verification
JWT_REFRESH_SECRET="streamforge_jwt_refresh_secret_key_minimum_32_characters_long_local"

# Minimum 32-character secret for HLS manifest-rewrite and segment HMAC URL signing
HMAC_MANIFEST_SECRET="streamforge_hmac_manifest_signing_secret_minimum_32_chars_local"

# Admin user password used during database seeding (npm run db:seed)
SEED_ADMIN_PASSWORD="StreamForge_Admin_DevPassword_2026!"

# Seeding protection flag (set to 'true' in development/staging environments)
ALLOW_SEED="true"

# ------------------------------------------------------------------------------
# 4. Storage & Media (MinIO Local / Cloudflare R2 Production)
# ------------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="streamforge-media"
S3_FORCE_PATH_STYLE="true"

# ------------------------------------------------------------------------------
# 5. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
